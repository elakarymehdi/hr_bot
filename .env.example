# =============================================================================
# HR Profile Matcher — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Supabase (required) ---
# Create a project at https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Groq API (required for LLM parsing) ---
# Get a free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- LinkedIn Credentials (required for scraping) ---
LINKEDIN_EMAIL=your-linkedin-email@example.com
LINKEDIN_PASSWORD=your-linkedin-password

# --- LLM Backend (optional) ---
# Set to "true" to use a local Ollama instance instead of Groq
# LOCAL_LLM=false

# --- CORS (optional) ---
# Comma-separated list of allowed origins for the API
# CORS_ORIGINS=http://localhost:5173,https://your-app.com

# --- Frontend Vite build variables (required for frontend Docker build) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
